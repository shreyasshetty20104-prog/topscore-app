# Copy to .env and fill in real values. Never commit .env itself.

# A username and password (you make these up) — protects the /admin page
# with a real login prompt so random visitors can't approve or reject bids.
ADMIN_USER=admin
ADMIN_PASS=change-this-to-your-own-secret

# Where this app is deployed. Used for CORS. Leave as-is for local testing.
CLIENT_URL=http://localhost:4242

PORT=4242 
